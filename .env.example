# Discord application (https://discord.com/developers/applications → deine App)
# Beide Werte stehen unter "OAuth2". Die Client-ID wird auch im Client gebraucht (VITE_-Prefix).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
VITE_DISCORD_CLIENT_ID=
# Unter OAuth2 -> Redirects genau diesen Wert eintragen (Platzhalter, wird nie aufgerufen)
DISCORD_REDIRECT_URI=https://127.0.0.1

# Port des Servers (der Discord-Proxy / Cloudflare Tunnel zeigt hierauf)
PORT=3100

# Optional: läuft ein warden (https://github.com/vxnsin/warden), vergibt er den Port und PORT ist nur der Wunsch
# WARDEN_URL=http://127.0.0.1:7010
# WARDEN_NAME=aniwatch
# WARDEN_TOKEN=
# WARDEN=0 fragt ihn gar nicht erst

# 1 = Entwickeln im normalen Browser ohne Discord: http://localhost:3100/?dev=1&name=luis
ALLOW_DEV=1
